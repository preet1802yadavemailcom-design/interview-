# ==============================================================================
# InterviewCapture — Environment Configuration Template
# ==============================================================================
# Copy this file to `client/.env` and supply your actual credentials.
# NEVER commit `client/.env` or secret keys to source control.
# ==============================================================================

# 1. Supabase Project Credentials (REQUIRED)
# Found in: Supabase Dashboard -> Project Settings -> API
# Use the "Project URL" and the public "anon / publishable" key.
# DO NOT USE the "service_role" secret key here!
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Application Name displayed in UI and page titles
VITE_APP_NAME=InterviewCapture

# 2. Configurable WebRTC TURN/STUN Relay (OPTIONAL)
# Public STUN servers are used by default for direct P2P connections.
# For corporate, campus, or cellular networks behind symmetric NAT,
# configure a TURN relay using either Option A or Option B:
#
# Option A: Full JSON ICE server definition
# VITE_ICE_SERVERS='[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478"],"username":"turn_user","credential":"turn_password"}]'
#
# Option B: Discrete TURN parameters (e.g. from Twilio, Metered, Coturn, or Cloudflare Calls)
# VITE_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp
# VITE_TURN_USERNAME=turn_user
# VITE_TURN_CREDENTIAL=turn_password
